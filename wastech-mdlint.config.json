{
  // The schema is generated by the linter and tracked beside this file: the tool is not published to
  // a package registry, so there is no dependency copy to point at, and a remote URL would tie
  // editor validation to network access and to a version other than the one that runs here.
  // Regenerate it with the linter's `schema` command whenever the linter itself is upgraded.
  "$schema": "./wastech-mdlint.schema.json",

  // ONE corpus definition for TWO branch states. This branch carries no derived documentation — under
  // `docs/` it keeps only the task queue — while the documentation branch adds the reconstructed
  // guide next to that queue. A glob that selects nothing is an empty set, not an error, so this one
  // list serves both: `docs/**` means "the queue" here and "the queue plus the guide" there. That is
  // also why this file must be edited on the development branch only — a second, divergent copy on
  // the documentation branch would conflict on every merge between them, and merges in that
  // direction are the only way code reaches it.
  "include": [
    "./*.md", // anchored on purpose: the repository's own root documents, not every README in the tree
    ".agents/**/*.md", // the mandatory rules every coding agent reads
    ".claude/skills/**/*.md", // agent workflows: context the harness loads verbatim
    "docs/**/*.md", // the task queue on this branch; queue + guide on the documentation branch
    "src/wastech_orchestrator/packaged/**/*.md" // shipped operator guide and flow role prompts
  ],

  // Test fixtures are deliberately absent from the list above: the role-prompt fixtures under
  // `tests/` are asserted by the suite, so their shape is already pinned by code, and linting them
  // as documentation would report on files nobody reads.
  "exclude": [
    // A recorded agent audit rather than authored documentation: its links are absolute paths on the
    // host that produced it, and rewriting them to resolve would falsify the record.
    "**/*.codex.audit.md",
    // Produced by a research run and regenerated rather than maintained; its shape belongs to the run
    // that wrote it, so holding it to the standards of hand-written documentation reports noise.
    "docs/research/**",
    // The `full-tool-access` ADR campaign. Unlike the two entries above, this one is a deliberate
    // trade rather than a statement that the files are not documentation, so it is written down in
    // full.
    //
    // WHY: the campaign is 25 design records with 139 links between them — requirements citing the
    // phases that implement them, phases citing the preconditions they rest on, audits citing both
    // while arguing with them — which puts all of them in one strongly-connected component and so
    // trips GRP-001 ("no reference cycle spanning three or more documents"). Making it acyclic
    // measured out at ~37 links to cut, ~24 of them genuine peer citations; an ADR whose phase may
    // not point at the requirement it implements is a worse record, not a tidier one. GRP-001 takes
    // no per-path exclusion (only `severity` and `minCycleLength`), and the linter has no inline
    // suppression, so scoping the trade to this folder is only expressible here, at the corpus
    // level.
    //
    // WHAT IT COSTS, because it is more than the one rule it was aimed at: these files leave the
    // corpus for EVERY rule. REF-001 stops checking 1,302 relative links from them, 889 of those
    // into `src/`, and GRP-002 stops noticing if one goes unreachable. That is not hypothetical —
    // moving two documents into a subfolder silently broke 29 `../../src/` links elsewhere in this
    // queue, and REF-001 is what caught it. Assume link rot in this folder is now unmonitored.
    //
    // WHEN TO REMOVE IT: when the campaign is finished and its documents are archived or deleted
    // (step 4 closed as unnecessary on 2026-09-03, so what is left is the campaign's own wind-down),
    // or if the linter gains a per-path exclusion
    // for GRP-001 — either makes the narrow fix available and this entry unnecessary.
    "docs/backlog/full-tool-access/**"
  ],

  // Every rule below reports ZERO over this corpus today, so any output at all means a new problem
  // rather than an old one — that is the property that keeps the gate worth reading. A rule is added
  // here only once it measures zero and only when it guards an invariant this repository actually
  // has; the deliberate omissions are recorded at the end of the list.
  "rules": [
    // Relative links resolve. This is the rule that makes the two-branch split machine-checked: a
    // shared document may only reach a documentation-branch-only file through an absolute URL,
    // because a relative path to it dangles on this branch — and that is now a failing build rather
    // than a convention.
    { "rule": "REF-001" },
    // Link anchors match a real heading slug. Cheap, and it catches the renamed-heading class of
    // breakage that a plain link check cannot see.
    { "rule": "REF-002" },
    // Image targets resolve. Only the root README carries an image today; the rule costs nothing and
    // means the first broken screenshot path is caught rather than published.
    { "rule": "REF-003" },

    // No reference cycle spanning three or more documents. A corpus of this size, where indexes link
    // members and members link back, is exactly where a cycle stops being visible by reading.
    { "rule": "GRP-001" },

    // Every document is reachable from another one. Raised from its default advisory severity because
    // the queue index is the entry point for the work in it: an item nothing links to is an item
    // nobody picks up, which is a real defect here rather than a style preference.
    {
      "rule": "GRP-002",
      "severity": "error",
      "options": {
        // Two trees are selected by machinery instead of by links, so orphanhood carries no signal in
        // them: a flow's role prompts are named by the flow definition next to them, and an agent
        // skill is discovered by its directory. Both would report as orphans forever (51 and 9 files
        // today) while telling nobody anything.
        "exclude": [
          "src/wastech_orchestrator/packaged/flows/**",
          ".claude/skills/**"
        ]
      }
    },

    // Per-file size budgets, as ratchets rather than aspirations: each threshold sits just above what
    // the corpus measures today, so the rule is green now and fires when a document grows past the
    // size its class has proven it can live within. Tighten a number as its class shrinks; never
    // raise one to silence a finding.
    {
      "rule": "SIZE-001",
      "options": {
        // First match wins, so the narrow patterns come first.
        "overrides": [
          {
            // Role prompts are paid for on every single node run of every task, which makes them the
            // most cost-sensitive Markdown in the repository. Largest today: 1,458 estimated tokens.
            "pattern": "src/wastech_orchestrator/packaged/flows/**",
            "tokens": { "warn": 1800, "error": 2600 }
          },
          {
            // The shipped operator guide: read by a human, so a larger budget is legitimate, but it
            // is also copied into every installation. Largest today: 9,814 estimated tokens.
            "pattern": "src/wastech_orchestrator/packaged/guide/**",
            "tokens": { "warn": 11000, "error": 14000 }
          },
          {
            // The derived documentation: written for a reader who arrives through the published site,
            // where a reference page is meant to be long. Selects nothing on this branch — the tree
            // exists only on the documentation branch — which is exactly how one config serves both.
            // Largest there today: 27,079 estimated tokens.
            "pattern": "docs/*.md",
            "tokens": { "warn": 28000, "error": 34000 }
          },
          {
            // Working queue documents, the loosest class: an item is written once, implemented from,
            // and then removed. Largest today: 24,274 estimated tokens — far above the 1,436-token
            // median, so the warn threshold is set to catch the next outlier rather than to bless
            // this one.
            "pattern": "docs/backlog/**",
            "tokens": { "warn": 26000, "error": 32000 }
          }
        ],
        // Everything else is agent-facing context — the root documents, the rules, the skills — where
        // size is a direct tax on every run. Largest today: 6,166 estimated tokens.
        "tokens": { "warn": 7000, "error": 9000 }
      }
    },

    // The eager-import budget for what an agent loads before it reads a single line of code. Both
    // entrypoints resolve their import closure to under 2,000 estimated tokens today; the ceiling is
    // an error rather than a warning because this cost is paid by every agent on every task, and
    // nothing else in the repository measures it.
    {
      "rule": "LLM-001",
      "severity": "error",
      "options": {
        "entrypoints": ["./CLAUDE.md", "./AGENTS.md"],
        "maxTokensPerEntrypoint": 3000
      }
    },

    // Sections that are empty or hold nothing but a placeholder. Left at its advisory severity
    // deliberately: the check reads structure, and a document whose body is a configuration example
    // hands comment lines to the Markdown parser as headings, so a finding here is worth reading
    // rather than obeying.
    {
      "rule": "CTX-001",
      "options": {
        // Task examples shipped as Markdown whose content is YAML: every `#` comment inside them
        // parses as a heading, which is what produced all five findings this rule had before the
        // exclusion. The examples are correct; the parse of them is not.
        "exclude": ["src/wastech_orchestrator/packaged/guide/tasks/**"]
      }
    }

    // Deliberately NOT enabled, so the next reader does not have to re-derive why:
    //
    // CTX-002 (all checklist items checked) — 17 findings, every one of them correct content: the
    //   operator guide ships checklists for the reader to work through, so unchecked boxes are the
    //   feature, not a defect.
    // SEC-001 / SEC-002 (required sections, section order) — the queue documents share no stable
    //   heading set today, so any list here would invent a template rather than enforce one.
    // STR-001 (required files exist) and CTX-003 (canonical glossary terms) — both presuppose the
    //   derived documentation, which this branch does not carry; they live in the additive config
    //   that exists only on the documentation branch.
    // TBL-*, REF-004 / REF-005 / REF-006, GRP-003, SEC-003 — no table schema, zone, or traceable-id
    //   convention exists here for them to check.
  ]
}
