{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/stop_checks.py",
            "timeout": 180,
            "statusMessage": "Quality gate: ruff + pytest"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/docs_sync_gate.py",
            "timeout": 30,
            "statusMessage": "Docs sync gate"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(rtk git *)",
      "Bash(rtk ls *)",
      "Bash(rtk grep *)",
      "Bash(.venv/bin/ruff check *)",
      "Bash(.venv/bin/mypy src *)",
      "Bash(xargs sed -n '1,12p')",
      "Bash(git rm *)",
      "Bash(rtk find *)",
      "Bash(awk 'NR>=1 && NR<=70 {print length\": \"NR}' src/wastech_orchestrator/cli.py)",
      "Bash(rtk pytest *)",
      "Bash(.venv/bin/pytest tests/test_cli_install.py -q)",
      "Bash(.venv/bin/mypy src/wastech_orchestrator/cli.py)"
    ]
  }
}
