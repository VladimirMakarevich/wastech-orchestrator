// wastech-orchestrator — Architecture as Code (C4 через LikeC4).
//
// Эта модель выведена из исполняемого кода — та же фактическая модель, что и в docs/functional/.
// Она РУЧНАЯ (не генерится из Python и без привязок `файл:строка`): при изменении границ блоков,
// связей, внешних систем или хранилищ обновляйте её тем же изменением (см. skill `sync-docs`).
// Детали, ошибки и ссылки на код по каждому блоку — в docs/functional/blocks/.
//
// Структура файла: specification (виды + теги + стили) → model (элементы + связи) → views.
// Для крупной модели это можно разнести по файлам spec.likec4 / model.likec4 / views.likec4 —
// LikeC4 объединяет все *.likec4 в каталоге.

specification {

  element actor {
    style {
      shape person
    }
  }
  element system {
    style {
      color indigo
    }
  }
  element externalSystem {
    style {
      color muted
    }
  }
  element container {
    style {
      color blue
    }
  }
  element component {
    style {
      color sky
    }
  }
  element store {
    style {
      shape cylinder
      color green
    }
  }

  // Семантические теги (видны в легенде; помогают фильтровать и осмыслять модель).
  tag spine
  tag entrypoint
  tag crosscutting
  tag external
  tag datastore
}

model {

  operator = actor 'Оператор' 'Запускает команды CLI и отвечает на HITL-запросы'
  human    = actor 'Человек в контуре' 'Согласует планы, опасные диффы, изменившийся набор проверок'

  // --- Внешние системы (дочерние процессы / сеть) ---
  codex = externalSystem 'Codex CLI' 'Кодинг-агент (дочерний процесс)' {
    #external
  }
  claude = externalSystem 'Claude Code CLI' 'Кодинг-агент (дочерний процесс)' {
    #external
  }
  github = externalSystem 'Git / GitHub' 'Ветки, коммиты, Pull Request (git + gh)' {
    #external
  }
  telegram = externalSystem 'Telegram Bot API' 'Транспорт HITL и уведомлений' {
    #external
  }

  // --- Система в фокусе ---
  orchestrator = system 'wastech-orchestrator' 'Оркестратор кодинг-агентов: одна задача за раз' {

    proc = container 'Orchestrator Process' 'Один процесс, детерминированный конвейер' {
      technology 'Python CLI'

      cli = component 'B01 CLI' 'Разбор аргументов, диспетчер подкоманд, коды возврата' {
        #entrypoint
        link ../functional/blocks/B01-cli-and-operator-commands.md 'Блок B01'
      }
      watch = component 'B02 watch-демон' 'Периодическое обнаружение pending-задач, по одной' {
        #entrypoint
        link ../functional/blocks/B02-watch-daemon-and-scheduling.md 'Блок B02'
      }
      config = component 'B05 Конфигурация' 'Загрузка и валидация config.yaml (fail-closed)' {
        link ../functional/blocks/B05-configuration.md 'Блок B05'
      }
      pipeline = component 'B06 Конвейер' 'Спайн: драйвит задачу через все стадии, владеет статусами' {
        #spine
        link ../functional/blocks/B06-orchestrator-pipeline.md 'Блок B06'
      }
      state = component 'B07 State Store' 'Машина состояний + персист в SQLite' {
        link ../functional/blocks/B07-state-machine-and-store.md 'Блок B07'
      }
      gate = component 'B16 Шлюз задачи' 'Парсинг и валидация §19 до слота и ветки' {
        link ../functional/blocks/B16-task-parsing-and-validation-gate.md 'Блок B16'
      }
      router = component 'B17 Router' 'Выбор провайдера + fallback (только инфра-сбой)' {
        link ../functional/blocks/B17-agent-router-and-fallback.md 'Блок B17'
      }
      providers = component 'B18 Провайдеры' 'Адаптеры Codex/Claude: argv, парсинг, классификация' {
        link ../functional/blocks/B18-agent-providers.md 'Блок B18'
      }
      subprocess = component 'B19 Безопасный запуск' 'run_process: argv без shell, таймаут, env-аллой-лист' {
        link ../functional/blocks/B19-subprocess-runner.md 'Блок B19'
      }
      resolver = component 'B23 Резолвинг проверок' 'Какой профиль проверок запускать (кэш по fingerprint)' {
        link ../functional/blocks/B23-check-discovery.md 'Блок B23'
      }
      checks = component 'B24 Проверки' 'Запуск профиля по порядку; launch-сбой ≠ качество' {
        link ../functional/blocks/B24-check-execution.md 'Блок B24'
      }
      gitmgr = component 'B22 Git Manager' 'Единственный делает commit/push/PR (идемпотентно)' {
        link ../functional/blocks/B22-git-manager.md 'Блок B22'
      }
      security = component 'B25 Security' 'Неослабляемая политика: env, forbidden, инъекции, изоляция' {
        #crosscutting
        link ../functional/blocks/B25-security-policy.md 'Блок B25'
      }
      redaction = component 'B21 Redaction' 'Вычистка секретов из стоков/логов/артефактов' {
        #crosscutting
        link ../functional/blocks/B21-secret-redaction.md 'Блок B21'
      }
      notifier = component 'B26 Telegram' 'Контракт Notifier + транспорт Telegram' {
        link ../functional/blocks/B26-notifications-telegram.md 'Блок B26'
      }
      observ = component 'B27 Observability' 'Логирование без секретов + heartbeat' {
        #crosscutting
        link ../functional/blocks/B27-observability.md 'Блок B27'
      }

      // Остальные блоки — компоненты того же proc; добавляются по тому же шаблону:
      // B03/B04 Install+Registry, B08 Ledger, B09 Fix-loop, B10 Recovery, B11 Decomposition,
      // B12 HITL, B13 Skills, B14 Dangerous-diff, B15 Prompts, B20 Artifact-layout.
    }

    db = store 'State Store (state.db)' 'tasks, stage_runs, provider_attempts, check_runs, …' {
      #datastore
      technology 'SQLite'
    }
    artifacts = store 'Artifact Store' 'request / result / stdout / логи / HITL / ledger' {
      #datastore
      technology 'Файловая система'
    }
    registry = store 'Binding Registry' 'repo → config.yaml' {
      #datastore
      technology 'JSON (per-user)'
    }
  }

  // --- Связи (выверены по коду; backbone, без всех сквозных рёбер) ---
  operator -> cli 'Подкоманды: run / watch / rerun / finalize / status'
  telegram -> human 'Запрос / ответ'

  cli -> config 'Загрузка + валидация'
  cli -> registry 'Поиск config.yaml'
  cli -> watch 'Диспетчер watch / stop / restart'
  cli -> pipeline 'run / rerun / finalize'
  watch -> pipeline 'resume / run_task (единый слот)'

  pipeline -> gate 'Валидация §19 (до слота и ветки)'
  gate -> security 'scan_frontmatter (инъекции)'
  pipeline -> state 'Переходы статусов (транзакция)'
  state -> db 'Читает / пишет'
  pipeline -> resolver 'Префлайт профиля проверок'
  pipeline -> router 'Агентские стадии'
  router -> providers 'AgentProvider.run'
  providers -> subprocess 'run_process'
  providers -> codex 'Запуск (argv, без shell)'
  providers -> claude 'Запуск (argv, без shell)'
  providers -> security 'Профиль / env / forbidden'
  providers -> redaction 'Редакция стоков'
  pipeline -> checks 'Стадия testing'
  checks -> subprocess 'run_process'
  pipeline -> gitmgr 'Ветка / commit / push / PR'
  gitmgr -> subprocess 'run_process'
  gitmgr -> github 'git / gh'
  gitmgr -> db 'publish_operations (идемпотентность)'
  pipeline -> notifier 'HITL / уведомления'
  notifier -> telegram 'send / getUpdates'

  providers -> artifacts 'request / result / логи'
  checks -> artifacts 'Логи проверок'
  gitmgr -> artifacts 'Диффы'
  observ -> redaction 'RedactionFilter'
}

views {

  view landscape {
    title 'Контекст системы (C4 L1)'
    include operator, human, orchestrator, codex, claude, github, telegram
    autoLayout LeftRight
  }

  view containers of orchestrator {
    title 'Контейнеры оркестратора (C4 L2)'
    include *
    autoLayout LeftRight
  }

  view components of proc {
    title 'Компоненты процесса = функциональные блоки (C4 L3)'
    include *
    autoLayout TopBottom
  }

  view crosscutting {
    title 'Сквозные: безопасность, редакция, наблюдаемость'
    include security, redaction, observ, providers, gitmgr, checks, subprocess, gate, db, artifacts
    autoLayout
  }

  dynamic view happyPath {
    title 'Happy-path: одна задача от run до PR'
    operator -> cli 'run: файл задачи'
    cli -> pipeline 'run_task'
    pipeline -> gate 'валидация §19'
    pipeline -> state 'захват слота, NEW→VALIDATED'
    pipeline -> resolver 'префлайт профиля проверок'
    pipeline -> gitmgr 'подготовка ветки'
    pipeline -> router 'implementation / planning'
    router -> providers 'AgentProvider.run'
    providers -> codex 'argv (без shell)'
    pipeline -> checks 'testing'
    pipeline -> router 'review'
    pipeline -> gitmgr 'commit / push / PR'
    gitmgr -> github 'gh pr create'
    pipeline -> notifier 'уведомление об исходе'
  }

  dynamic view implementationFlow {
    title 'Поток исполнения единицы: стадии S01-S08 с петлёй ping-pong'
    pipeline -> router 'S01 refinement (опц.)'
    pipeline -> router 'S02 planning (опц.) + декомпозиция'
    pipeline -> router 'S03 implementation (+ guardrail B14)'
    pipeline -> checks 'S04 testing (опц.)'
    checks -> pipeline 'качественный провал'
    pipeline -> router 'S06 fixing (лимиты B09)'
    pipeline -> checks 'назад к testing — ping-pong'
    pipeline -> router 'S05 review (опц.)'
    router -> pipeline 'блокирующие находки → fixing'
    pipeline -> gitmgr 'S07 summary → S08 commit / push / PR'
    gitmgr -> github 'gh pr create'
  }
}
