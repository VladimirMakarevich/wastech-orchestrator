{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wastech-orchestrator/flow.schema.json",
  "title": "wastech-orchestrator flow contract (co-design draft, Step 0)",
  "type": "object",
  "required": ["flow"],
  "additionalProperties": false,
  "properties": { "flow": { "$ref": "#/$defs/flow" } },
  "$defs": {
    "flow": {
      "type": "object",
      "required": [
        "name",
        "task_type",
        "permission_ceiling",
        "output_policy",
        "publishing",
        "nodes",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "task_type": { "type": "string" },
        "permission_ceiling": { "enum": ["read-only", "workspace-write"] },
        "output_policy": {
          "enum": [
            "code_change",
            "repository_document",
            "private_control_workspace_report"
          ]
        },
        "publishing": {
          "enum": [
            "pull_request",
            "documentation_pull_request",
            "local_artifact",
            "none",
            "private_control_workspace_report"
          ]
        },
        "network_policy": { "enum": ["advisories", "research"] },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent": { "type": "object" },
            "evaluator": { "type": "object" },
            "checks": { "type": "object" },
            "hitl": { "type": "object" },
            "publish": { "type": "object" }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "budgets": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "decomposition": { "$ref": "#/$defs/decomposition" }
      }
    },
    "when": {
      "type": "object",
      "required": ["fact"],
      "additionalProperties": false,
      "properties": {
        "fact": { "type": "string" },
        "equals": { "type": "boolean" }
      }
    },
    "reasoning": { "enum": ["low", "medium", "high", "xhigh", "max", null] },
    "provider": { "enum": ["codex", "claude", null] },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/agentNode" },
        { "$ref": "#/$defs/evaluatorNode" },
        { "$ref": "#/$defs/checksNode" },
        { "$ref": "#/$defs/hitlNode" },
        { "$ref": "#/$defs/publishNode" }
      ]
    },
    "agentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "role_file"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "agent" },
        "role_file": { "type": "string" },
        "session_scope": {
          "enum": ["editing_lineage", "fresh_disposable", "resume_own_lineage"]
        },
        "lineage_affinity": { "type": ["string", "null"] },
        "permission_profile": { "enum": ["read-only", "workspace-write"] },
        "provider": { "$ref": "#/$defs/provider" },
        "model": { "type": ["string", "null"] },
        "reasoning": { "$ref": "#/$defs/reasoning" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "output_schema": { "type": ["object", "null"] },
        "hitl": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow_question": { "type": "boolean" },
            "allow_approval": { "type": "boolean" }
          }
        },
        "extra_args": { "type": "array", "items": { "type": "string" } },
        "when": { "$ref": "#/$defs/when" }
      }
    },
    "evaluatorNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "role", "role_file"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "evaluator" },
        "role": { "type": "string" },
        "role_file": { "type": "string" },
        "session_scope": { "enum": ["fresh_disposable", "resume_own_lineage"] },
        "permission_profile": { "const": "read-only" },
        "evaluation_kind": { "enum": ["stage_output", "final_handoff"] },
        "blocking": { "type": "boolean" },
        "max_rework_per_stage": { "type": "integer", "minimum": 0 },
        "provider": { "$ref": "#/$defs/provider" },
        "model": { "type": ["string", "null"] },
        "reasoning": { "$ref": "#/$defs/reasoning" },
        "when": { "$ref": "#/$defs/when" }
      }
    },
    "checksNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "checker"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "checks" },
        "checker": {
          "enum": ["command_profile", "citation", "dependency_scan"]
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": ["auto", "configured", "deterministic", "disabled"]
            },
            "approve_command_changes": { "type": "boolean" }
          }
        },
        "when": { "$ref": "#/$defs/when" }
      }
    },
    "hitlNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "signal"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "hitl" },
        "signal": { "enum": ["question", "approval"] },
        "timeout_s": { "type": ["integer", "null"] },
        "when": { "$ref": "#/$defs/when" }
      }
    },
    "publishNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "policy"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "publish" },
        "policy": {
          "enum": [
            "pull_request",
            "documentation_pull_request",
            "local_artifact",
            "none",
            "private_control_workspace_report"
          ]
        },
        "when": { "$ref": "#/$defs/when" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "outcome": {
          "type": "string",
          "pattern": "^(accept|rework|pass|fail|route:[A-Za-z0-9_-]+)$"
        },
        "budget": { "type": "integer", "minimum": 0 },
        "loop": { "type": "string" }
      }
    },
    "decomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposed_by", "sub_flow"],
      "properties": {
        "proposed_by": { "type": "string" },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer" },
            "max": { "type": "integer" },
            "linear_depends_on": { "type": "boolean" }
          }
        },
        "sub_flow": { "type": "array", "items": { "type": "string" } },
        "commit_each_subtask": { "type": "boolean" },
        "shared_budget": { "type": "string" }
      }
    }
  }
}
