// wastech-orchestrator — Architecture as Code (C4 via LikeC4).
//
// This model is derived from executable code.
// It is MANUAL (not generated from Python and has no `file:line` bindings): when block boundaries,
// relationships, external systems, or stores change, update it in the same change (see skill `sync-docs`).
//
// File structure: specification (kinds + tags + styles) → model (elements + relationships) → views.
// For a large model this can be split into spec.likec4 / model.likec4 / views.likec4 —
// LikeC4 merges all *.likec4 files in the directory.

specification {

  element actor {
    style {
      shape person
    }
  }
  element system {
    style {
      color indigo
    }
  }
  element externalSystem {
    style {
      color muted
    }
  }
  element container {
    style {
      color blue
    }
  }
  element component {
    style {
      color sky
    }
  }
  element store {
    style {
      shape cylinder
      color green
    }
  }

  // Semantic tags (visible in the legend; useful for filtering and understanding the model).
  tag spine
  tag entrypoint
  tag crosscutting
  tag external
  tag datastore
}

model {

  operator = actor 'Operator' 'Runs CLI commands and responds to HITL requests'
  human    = actor 'Human in the loop' 'Approves plans and dangerous diffs'

  // --- External systems (child processes / network) ---
  codex = externalSystem 'Codex CLI' 'Coding agent (child process)' {
    #external
  }
  claude = externalSystem 'Claude Code CLI' 'Coding agent (child process)' {
    #external
  }
  github = externalSystem 'Git / GitHub' 'Branches, commits, Pull Requests (git + gh)' {
    #external
  }
  telegram = externalSystem 'Telegram Bot API' 'HITL and notification transport' {
    #external
  }

  // --- System in focus ---
  orchestrator = system 'wastech-orchestrator' 'Coding-agent orchestrator: one task at a time' {

    proc = container 'Orchestrator Process' 'Single process, deterministic pipeline' {
      technology 'Python CLI'

      cli = component 'B01 CLI' 'Argument parsing, subcommand dispatcher, exit codes' {
        #entrypoint
      }
      watch = component 'B02 watch daemon' 'Periodic discovery of pending tasks, one at a time' {
        #entrypoint
      }
      installer = component 'B03 Installer' 'worc install: detect the repo, write .worc/ (config, flows, tools, guide)' {
        #entrypoint
      }
      config = component 'B05 Configuration' 'Load and validate config.yaml (fail-closed)' {
      }
      pipeline = component 'B06 Orchestrator wrapper' 'Spine: gate · slot · branch · terminal cleanup; hands the graph to the engine' {
        #spine
      }
      engine = component 'B28 Flow Engine' 'Drives the node graph: routes outcomes, owns budgets, writes checkpoints' {
        #spine
      }
      supervisor = component 'B31 Supervisor' 'Read-only advisory layer (on by default, removable); observes at a configured cadence, writes the PR summary at close' {
      }
      report = component 'Summary Report' 'Deterministic PR body from state.db + artifacts when no provider prose reached disk' {
      }
      state = component 'B07 State Store' 'State machine + persistence in SQLite' {
      }
      ledger = component 'B08 Ledger' 'Append-only logs/completed.jsonl, one record per terminal transition; writes failure_report.json + stuck.md' {
      }
      loops = component 'B09 Loop Control' 'Per-task fix counters on the tasks row; effective cap = min(flow budget, agents.max_fix_cycles / max_total_fix_iterations)' {
      }
      decomp = component 'B11 Decomposition' 'Flag-gated planning sub-phase, off by default: the Core accepts a proposed split only by a deterministic rule (2..max_subtasks, linear depends_on)' {
      }
      hitl = component 'B12 HITL' 'Typed human_input / planning signals: strict validation, ask through the Notifier, redacted answer back as {human_input_path} on a fresh run' {
      }
      dangerous = component 'B14 Dangerous-diff Guard' 'Deterministic gate over the diff since the last orchestrator commit (gate_reference_sha, never HEAD): trust_level + protected paths. Shared by the agent node (denial = send back) and the publish node (denial = manual stop); asks at the edit, at that node hitl round-trip, and once before commit_code' {
        #crosscutting
      }
      gate = component 'B16 Task Gate' 'Parsing and §19 validation before slot and branch' {
      }
      router = component 'B17 Router' 'Provider selection + fallback (infrastructure failures only); owns the injected does-this-attempt-get-a-shell table and the config-legality (host-independent) rule for a capability_unavailable hop' {
      }
      providers = component 'B18 Providers' 'Codex/Claude adapters: argv, parsing, classification' {
      }
      subprocess = component 'B19 Subprocess Runner' 'run_process: argv without shell, timeout, env allowlist' {
      }
      resolver = component 'B23 Check Resolution' 'Normalize command_sets; diff-select which sets run for the touched paths' {
      }
      checks = component 'B24 Checks' 'Run all selected command sets; launch-fail / quality-fail / skip' {
      }
      tools = component 'B32 Flow Checkers + Tools' 'citation / dependency_scan checkers; operator tool nodes from .worc/tools/ (UTF-8 stdout contract)' {
      }
      exchange = component 'Exchange Publisher' 'The single redaction + path-safety boundary onto .worc-io/ (WRI-001); terminal seal / quarantine' {
        #crosscutting
      }
      frozen = component 'Frozen Bundles' 'Per-task immutable control + instruction snapshots under runs/ (WRI-010/011); post-attempt digest re-check' {
        #crosscutting
      }
      memory = component 'Memory' 'EXPERIMENTAL, off by default (and forced off without the supervisor): persistent repo-scoped store — packet build (read), supervisor-proposed delta (write), bounded idle curation' {
      }
      gitmgr = component 'B22 Git Manager' 'The only component that does commit/push/PR (idempotent). Structured PushOutcome / RemoteState: publishing recovers from a diverged remote (adopt locally, re-check, then push) and never infers provenance; re-reads the push destination immediately before sending' {
      }
      security = component 'B25 Security' 'Non-weakening policy: env allowlist + prefix patterns + assigned extra_environment (env, env_paths), absolutely-forbidden argv incl. both full-access selectors (forbidden_args), injections, isolation legality (isolation), and the provider-neutral shell-reach seam (shell_reach). strict_isolation false = advanced mode' {
        #crosscutting
      }
      redaction = component 'B21 Redaction' 'Strip secrets from streams/logs/artifacts' {
        #crosscutting
      }
      notifier = component 'B26 Telegram' 'Notifier contract + Telegram transport' {
      }
      observ = component 'B27 Observability' 'Secret-free logging + heartbeat' {
        #crosscutting
      }
      launchers = component 'Pinned Launchers' 'Absolute paths for what the orchestrator launches AS ITSELF, resolved once per run and reused for the rest of the process: git / gh / worc everywhere, plus ps (POSIX) and bwrap + socat (Linux), plus every CONFIGURED provider command. Reports drift. Closes the in-run PATH-substitution window — not a stand-in already in place before the run, and not an edit to the installed package' {
        #crosscutting
      }

      // Remaining blocks — components of the same proc; added by the same pattern:
      // B10 Recovery, B15 Prompts, B20 Artifact-layout,
      // B29 Flow-definition/validation, B30 Flow-node-runners.
      // Two numbers are RETIRED rather than pending, and neither will ever get a component:
      // B04 (Config-discovery) — the config `discovery` block was removed in config schema v15 and
      // is only tolerated as a legacy key today (see config/loader.py); B13 (Skills) — repo-skill
      // selection was removed outright (core/skills.py deleted): no discovery, no operator pins, no
      // supervisor proposal, no {skills_path}, no skill_map.json, and the `skills` config block is
      // now an unknown key that fails the load.
      // Components added after the B01–B32 taxonomy was closed carry descriptive names rather than
      // invented numbers: Summary Report, Exchange Publisher, Frozen Bundles, Memory,
      // Pinned Launchers.
    }

    db = store 'State Store (state.db)' 'tasks (+ base_ref, gate_reference_sha, push_url_digest), node_runs, provider_attempts, check_runs, evaluations, artifacts, subtasks, editing_lineage, node_lineage, publish_operations (+ pushed_sha) — schema v25' {
      #datastore
      technology 'SQLite'
    }
    artifacts = store 'Private home (.worc/)' 'config / flows / tools / guide · state.db · logs (+ ledger, daemon logs) · memory · security-reports · runs/ (frozen bundles, seals, quarantine)' {
      #datastore
      technology 'Filesystem'
    }
    exchangeRoot = store 'Agent exchange (.worc-io/)' 'The only provider-readable orchestration surface: redacted current-task copies (WRI-001)' {
      #datastore
      technology 'Filesystem'
    }
    workspace = store 'Repository working tree' 'The code the agents actually edit; it carries .worc/ and .worc-io/. Write-denied for the agent: .git, the effective hooks dir, tasks/, the exchange projection, the resolved env-file and runs/. Under advanced mode the agent writes across the workspace volume and those denies are carve-outs inside the grant; the agent CLI config homes (~/.claude, $CODEX_HOME) are in no deny projection at any setting' {
      #datastore
      technology 'Git worktree'
    }
    queue = store 'Task queue (tasks/)' 'The committed lifecycle tree (preparing/ -> pending/ -> ...): agent-readable, never agent-writable, so no task can be injected for the daemon to pick up' {
      #datastore
      technology 'Filesystem'
    }
  }

  // --- Relationships (verified against code; backbone, without all cross-cutting edges) ---
  // 26 subcommands, by group: setup (install · upgrade-config · upgrade-docs · completion) ·
  // run (run · watch · stop · restart · promote · rerun · finalize) ·
  // inspect (status · top · list · tasks · logs · runs · memory · prs · shell · clear) ·
  // check (preflight · validate-flow · telegram-test) · publish (merge-task).
  operator -> cli 'Subcommands: install · run / watch / stop / restart / promote / rerun / finalize · status / top / list / tasks / logs / runs / memory / prs · preflight / validate-flow'
  telegram -> human 'Question / approval request'
  human -> telegram 'Answer / approve / deny'

  cli -> installer 'install (writes .worc/ before anything else can run)'
  cli -> config 'Load + validate (discovered from .worc/)'
  config -> security 'Lexical gates at load: allowed_environment covers PATH, extra_environment points nowhere near .git / .worc / the exchange'
  cli -> watch 'Dispatch watch / stop / restart'
  cli -> pipeline 'run / rerun / finalize'
  cli -> queue 'promote: preparing/ -> pending/ (atomic move)'
  installer -> artifacts 'Create .worc/: config, flows, tools, guide'
  watch -> queue 'Discover pending task files'
  watch -> pipeline 'resume / run_task (single slot)'

  pipeline -> gate '§19 validation (before slot and branch)'
  gate -> queue 'Read the task file'
  gate -> ledger 'Duplicate-id check (completed.jsonl)'
  gate -> security 'scan_frontmatter (injections)'
  pipeline -> state 'Status transitions (transactional)'
  state -> db 'Read / write'
  pipeline -> resolver 'Normalize command_sets (preflight)'
  pipeline -> frozen 'Freeze control + instruction inputs at task start'
  pipeline -> engine 'drive_flow (hand off the validated graph)'
  supervisor -> engine 'Observes completed steps read-only, at the configured cadence'
  supervisor -> report 'No prose on disk (off / no-prose terminal / failed / collapsed) → deterministic body'
  report -> db 'Render from recorded facts (byte-identical across renders)'
  supervisor -> memory 'Proposes the candidate delta on its closing turn'
  engine -> memory 'Per-node retrieval packet ({memory_path})'
  memory -> artifacts 'Store + audit + snapshots under .worc/memory/'
  engine -> router 'Agent / evaluator nodes'
  engine -> frozen 'Reads the frozen copies; post-attempt digest re-check'
  engine -> decomp 'planning: accept or reject the proposed split (deterministic rule)'
  decomp -> db 'subtasks'
  engine -> loops 'Charge every rework / fail edge against the counters'
  loops -> db 'Counters on the tasks row'
  engine -> hitl 'Nodes with a human_input / planning contract'
  engine -> dangerous 'Writing nodes and their hitl round-trip, then once more in the publish node right before commit_code — three asking points over the diff since the last orchestrator commit'
  dangerous -> hitl 'Approval request for the classified change set'
  hitl -> notifier 'Notifier.ask (transport-agnostic), correlated'
  hitl -> artifacts 'Durable interaction records (resumable across restarts)'
  hitl -> engine 'Redacted answer -> {human_input_path} on a fresh run'
  router -> security 'attempt_has_shell table (injected): does THIS attempt get a shell?'
  router -> providers 'AgentProvider.run'
  providers -> subprocess 'run_process (containment + quiescence barrier)'
  providers -> launchers 'Pinned agent-CLI path'
  subprocess -> launchers 'Pinned ps for the quiescence barrier'
  cli -> launchers 'Resolve once at startup; report drift'
  providers -> codex 'Launch (argv, no shell)'
  providers -> claude 'Launch (argv, no shell)'
  providers -> security 'Profile / env / forbidden / git-evidence grant'
  providers -> redaction 'Stream redaction'
  security -> workspace 'Write-guard deny set per attempt THAT GETS A SHELL; drift is reported, never parks'
  codex -> workspace 'Edit code (Write/Edit inside the tree)'
  claude -> workspace 'Edit code (Write/Edit inside the tree)'
  engine -> checks 'Checks nodes (testing)'
  engine -> tools 'Checker + tool nodes'
  tools -> subprocess 'run_process (UTF-8 stdout)'
  checks -> subprocess 'run_process'
  engine -> exchange 'Publish each context path (redacted, contained)'
  exchange -> exchangeRoot 'Atomic LF-stable writes'
  exchange -> artifacts 'Terminal seal / quarantine under runs/'
  codex -> exchangeRoot 'Reads context paths'
  claude -> exchangeRoot 'Reads context paths'
  pipeline -> gitmgr 'Branch prep / terminal cleanup / git control-state fingerprint'
  engine -> gitmgr 'Publish node (commit / push / PR)'
  gitmgr -> subprocess 'run_process'
  gitmgr -> launchers 'Pinned git / gh path for every call'
  gitmgr -> workspace 'Branch, stage and commit from the working tree'
  gitmgr -> github 'git / gh (--repo pinned); adopt a diverged remote locally, re-check, then push — or refuse when the push destination moved'
  gitmgr -> db 'publish_operations + pushed_sha (idempotency); base_ref / gate_reference_sha / push_url_digest'
  pipeline -> ledger 'Terminal transition record (done / failed / manual_action_required)'
  ledger -> artifacts 'completed.jsonl · failure_report.json · stuck.md'
  pipeline -> notifier 'HITL / notifications / ⚠️ traces'
  notifier -> telegram 'send / getUpdates'

  providers -> artifacts 'request / result / logs'
  checks -> artifacts 'Check logs'
  gitmgr -> artifacts 'Diffs'
  observ -> redaction 'RedactionFilter'
}

views {

  view landscape {
    title 'System context (C4 L1)'
    include operator, human, orchestrator, codex, claude, github, telegram
    autoLayout LeftRight
  }

  view containers of orchestrator {
    title 'Orchestrator containers (C4 L2)'
    include *
    autoLayout LeftRight
  }

  view components of proc {
    title 'Process components = functional blocks (C4 L3)'
    include *
    autoLayout TopBottom
  }

  view crosscutting {
    title 'Cross-cutting: security, redaction, isolation boundaries, pinned launchers, observability'
    include security, redaction, observ, launchers, exchange, frozen, dangerous, providers, gitmgr, checks, subprocess, gate, router, db, artifacts, exchangeRoot, workspace
    autoLayout TopBottom
  }

  view isolation {
    title 'Isolation boundaries: what the agent may read and write, what is frozen, and what advanced mode gives up'
    include frozen, exchange, security, launchers, providers, codex, claude, artifacts, exchangeRoot, workspace, queue
    autoLayout LeftRight
  }

  dynamic view happyPath {
    title 'Happy path: one task from run to PR'
    operator -> cli 'run: task file'
    cli -> pipeline 'run_task'
    pipeline -> gate '§19 validation'
    pipeline -> state 'acquire slot, NEW→VALIDATED'
    pipeline -> resolver 'normalize command_sets (preflight)'
    pipeline -> frozen 'freeze control + instruction inputs'
    pipeline -> gitmgr 'branch preparation'
    pipeline -> engine 'drive_flow'
    engine -> router 'implementation / planning'
    router -> providers 'AgentProvider.run'
    providers -> codex 'argv (no shell)'
    engine -> exchange 'publish redacted context paths'
    engine -> checks 'testing'
    engine -> router 'review'
    supervisor -> engine 'observes deviations (read-only, cadence: events)'
    engine -> router 'documentation (docs follow the code)'
    supervisor -> report 'summary.md, else the deterministic body'
    engine -> gitmgr 'commit / push / PR'
    engine -> dangerous 'last ask, in the publish node right before commit_code (nothing new to approve on a clean run)'
    gitmgr -> github 'gh pr create'
    exchange -> artifacts 'seal the terminal exchange under runs/'
    pipeline -> notifier 'outcome notification'
  }

  // The counterpart of happyPath: what the same run does when something goes wrong. Fallback is for
  // infrastructure classes only — a quality failure, a review finding, or a security condition never
  // reaches it.
  dynamic view failurePath {
    title 'Failure paths: fallback, fix loops, park, and the three terminals'
    providers -> router 'Infrastructure error class (binary_not_found · rate_limited · timeout · process_crashed …)'
    router -> providers 'Fallback to the other provider — infrastructure classes only'
    router -> engine 'Every allowed provider exhausted'
    engine -> pipeline 'Disposition over the whole set of raised classes, security first'
    pipeline -> state 'containment_unverified / capability_unavailable -> manual_action_required, terminal git withheld'
    exchange -> artifacts 'Unsafe tree: quarantine instead of a terminal seal'
    pipeline -> state 'Park-eligible (rate limit · outage · operator stop): hold the checkpoint, a later tick resumes; past agents.retry.max_blocked_s it fails'
    pipeline -> state 'Otherwise terminal by node kind: agent -> failed · evaluator -> manual_action_required (its green diff stays reviewable)'
    checks -> engine 'Quality failure (tests / linters) -> fixing, never a fallback'
    engine -> router 'review: blocking findings -> fixing'
    engine -> loops 'Charge the rework edge'
    loops -> state 'Budget exhausted -> manual_action_required with a failure report'
    engine -> dangerous 'Diff since the last orchestrator commit hits the approval gate'
    dangerous -> hitl 'Ask the human to approve'
    hitl -> state 'Denied at a writing node -> send back; denied before commit_code -> manual_action_required (the agent is gone)'
    security -> notifier 'Git-control / workspace drift: WARNING + ⚠️ trace, and the run CONTINUES — no node class parks on it'
    gitmgr -> state 'Publish over an adopted remote: failing checks or a merge conflict -> parked, nothing pushed (worc merge-task is the way through)'
    gitmgr -> notifier 'Push destination moved -> refused outright; commits adopted -> ⚠️ trace when there is no PR body to say it'
    pipeline -> ledger 'Terminal record + failure_report.json / stuck.md'
    pipeline -> notifier 'Outcome notification'
  }

  dynamic view implementationFlow {
    title 'Implementation flow: the node graph with the bounded fix loop'
    pipeline -> engine 'drive_flow (validated graph)'
    engine -> router 'refinement (when derived.needs_refinement) · planning (+ decomposition)'
    engine -> router 'implementation (+ dangerous-diff guard B14)'
    engine -> checks 'testing (diff-selected command sets)'
    checks -> engine 'quality failure → fixing'
    engine -> router 'fixing (bounded loops B09; resumes the editing lineage)'
    engine -> checks 'back to testing — ping-pong'
    engine -> router 'review (read-only evaluator, findings gate)'
    router -> engine 'blocking findings → fixing'
    engine -> router 'documentation (once per task, after review accepts)'
    supervisor -> engine 'observes deviations; writes the summary at close'
    engine -> gitmgr 'publish: commit / push / PR'
    gitmgr -> github 'gh pr create'
  }
}
