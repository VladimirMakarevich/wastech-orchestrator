{
  // The same generated schema the shared config points at; it is a tracked file beside both.
  "$schema": "./wastech-mdlint.schema.json",

  // ADDITIVE, not a second opinion. The shared config already lints every file selected here, with
  // the rules that hold on every branch — this file adds only what cannot be expressed there, so no
  // document is ever reported twice. It exists on THIS branch alone, and that is the mechanism rather
  // than an accident: the development branch carries no derived documentation, so a rule asserting
  // that documentation exists would fail there by design. A path the incoming branch does not have
  // also cannot conflict when it merges, which is why the split is a second file instead of a second
  // spelling of the first one.
  "include": ["docs/*.md"],

  "rules": [
    // The published documentation set, page for page. This is what turns "the derived docs were
    // reconstructed from the merged development diff" from a promise into a check: a page deleted,
    // renamed, or never written fails the build on the branch that owns it. The list is the set the
    // site publishes, so it stays in step with the navigation rather than describing a wish. Verified
    // green over this tree, and verified to fire — moving any one page away reports it as missing.
    {
      "rule": "STR-001",
      "options": {
        "files": [
          "docs/index.md",
          "docs/how-it-works.md",
          "docs/how-to.md",
          "docs/operations.md",
          "docs/configuration.md",
          "docs/task-authoring.md",
          "docs/flow-authoring.md",
          "docs/cookbook.md",
          "docs/telegram.md",
          "docs/glossary.md",
          "docs/worc_architecture.md"
        ]
      }
    }

    // Deliberately NOT here yet, both for the same reason — the rule would need a change to the
    // documents before it could measure anything:
    //
    // CTX-003 (canonical glossary terms) needs the glossary page to expose a canonical-term column
    //   and an alias column the rule can read. That is a decision about the page's shape.
    // SEC-003 (sections conform to a template) needs one guide page nominated as the template the
    //   others follow. The pages differ on purpose today, so nominating one is editorial first.
  ]
}
